{
  "name": "bureau",
  "version": "1.0.0",
  "description": "BUREAU \u2014 the autonomous digital design bureau. Skill, toolkit and review circuit for award-grade web design.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/acf1210/bureau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acf1210/bureau.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "node skill/scripts/audit.mjs",
    "slop": "node skill/scripts/audit.mjs .",
    "qa": "node skill/scripts/visual-audit.mjs",
    "review": "node skill/scripts/review.mjs",
    "doctor": "node skill/scripts/doctor.mjs",
    "new": "node skill/scripts/new-project.mjs",
    "tokens": "node skill/scripts/tokens.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:serve": "npm run docs:build && node scripts/serve.mjs dist 4173",
    "og": "node scripts/og.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:claude": "./installers/install.sh --agent claude --scope user",
    "install:codex": "./installers/install.sh --agent codex --scope user",
    "install:antigravity": "./installers/install.sh --agent antigravity --scope user",
    "install:hermes": "./installers/install.sh --agent hermes --scope user"
  },
  "devDependencies": {
    "marked": "^16.4.0",
    "playwright": "^1.64.0"
  }
}
